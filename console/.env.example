# OIDC / Keycloak settings, injected by Vite at build time (browser-visible).
# The defaults shown here match the Keycloak compose stack in console/compose.yaml.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=fastvm
VITE_KEYCLOAK_CLIENT_ID=fastvm-console
VITE_KEYCLOAK_SCOPE=openid profile email

# FASTVM_SOCKET is NOT a browser variable. It is read server-side by the dev /
# preview proxy (vite-plugins/fastvm-proxy.ts) to reach fastvmd's unix socket.
# Default: /run/fastvm/fastvm.sock
# FASTVM_SOCKET=/run/fastvm/fastvm.sock
