# OpenAI Codex coding-agent sandbox.
#
#   export OPENAI_API_KEY=...
#   fastvmctl run -f hack/codex.fvmfile -it
#
# Starts from the normal Node.js image and installs the Codex CLI on first boot.
version: 1
name: codex
image: node:26-slim
entrypoint: ["codex"]

user_data: |
  #!/bin/sh
  set -eu
  npm install -g --no-fund --no-audit @openai/codex

# ${NAME} values are expanded from the host environment.
env:
  OPENAI_API_KEY: "${OPENAI_API_KEY}"

network:
  enabled: true
  allow_hosts:
    - registry.npmjs.org
    - api.openai.com
    - auth.openai.com

resources:
  vcpus: 2
  memory_mb: 4096

no_auto_sleep: true
