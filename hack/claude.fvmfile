# Anthropic Claude Code coding-agent sandbox.
#
#   export ANTHROPIC_API_KEY=...
#   fastvmctl run -f hack/claude.fvmfile -it
#
# Starts from the normal Node.js image and installs Claude Code on first boot.
version: 1
name: claude
image: node:26-slim
entrypoint: ["claude"]

user_data: |
  #!/bin/sh
  set -eu
  npm install -g --no-fund --no-audit @anthropic-ai/claude-code

# ${NAME} values are expanded from the host environment.
env:
  ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY}"

network:
  enabled: true
  allow_hosts:
    - registry.npmjs.org
    - api.anthropic.com

resources:
  vcpus: 2
  memory_mb: 4096

no_auto_sleep: true
